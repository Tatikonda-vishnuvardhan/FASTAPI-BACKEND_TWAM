# ═══════════════════════════════════════════════════════════════════════════════
# TWAM E-Commerce Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/twam
DATABASE_SCHEMA=twam

# ── JWT / Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://onlytwam.com,capacitor://localhost

# ── Company Info (used in notifications) ───────────────────────────────────────
COMPANY_NAME=Only TWAM
SUPPORT_EMAIL=support@onlytwam.com
SUPPORT_PHONE=+91-XXXXXXXXXX

# ═══════════════════════════════════════════════════════════════════════════════
# EKART LOGISTICS INTEGRATION
# ═══════════════════════════════════════════════════════════════════════════════

# ── Ekart API Credentials ──────────────────────────────────────────────────────
# Get these from your Ekart Logistics dashboard
EKART_API_URL=https://api.ekartlogistics.com
EKART_API_KEY=your_ekart_api_key
EKART_API_SECRET=your_ekart_api_secret
EKART_SELLER_ID=your_seller_id

# ── Pickup & Return Locations ──────────────────────────────────────────────────
# These are location IDs registered with Ekart
EKART_PICKUP_ID=your_pickup_location_id
EKART_RETURN_ID=your_return_location_id

# Return warehouse address used for reverse pickups
EKART_RETURN_NAME=Only TWAM Warehouse
EKART_RETURN_PHONE=+91-XXXXXXXXXX
EKART_RETURN_ADDRESS_LINE1=Warehouse address line 1
EKART_RETURN_ADDRESS_LINE2=
EKART_RETURN_CITY=Chennai
EKART_RETURN_STATE=Tamil Nadu
EKART_RETURN_PINCODE=600001
EKART_RETURN_COUNTRY=India

# ── Webhook Security ───────────────────────────────────────────────────────────
# Secret for verifying Ekart webhook callbacks
EKART_WEBHOOK_SECRET=your_webhook_secret

# ── Mock Mode (for testing without Ekart API) ──────────────────────────────────
# Set to "true" to use mock responses instead of real API calls
EKART_MOCK_MODE=true

# ── Tracking URL ───────────────────────────────────────────────────────────────
TRACKING_BASE_URL=https://ekartlogistics.com/track

# ═══════════════════════════════════════════════════════════════════════════════
# NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════════════════

# ── SMS Integration (placeholder - add your provider) ──────────────────────────
# Example for MSG91:
# SMS_API_URL=https://api.msg91.com/api/v5/flow/
# SMS_API_KEY=your_msg91_auth_key
# SMS_TEMPLATE_ID=your_template_id

# Example for Twilio:
# SMS_API_URL=https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/Messages.json
# SMS_API_KEY=your_twilio_auth_token
# SMS_ACCOUNT_SID=your_twilio_account_sid
# SMS_FROM_NUMBER=+1234567890

SMS_API_URL=
SMS_API_KEY=

# ── WhatsApp Integration (optional) ────────────────────────────────────────────
# Example for Gupshup:
# WHATSAPP_API_URL=https://api.gupshup.io/sm/api/v1/msg
# WHATSAPP_API_KEY=your_gupshup_api_key

# Example for Twilio:
# WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/Messages.json
# WHATSAPP_API_KEY=your_twilio_auth_token

WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# PAYMENT GATEWAY (if applicable)
# ═══════════════════════════════════════════════════════════════════════════════
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
